{
  "name": "english-writing-assistant",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create writing-assistant-db",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:remote": "node scripts/migrate.js --remote",
    "typecheck": "tsc --noEmit",
    "secret:key": "wrangler secret put ENCRYPTION_KEY"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
