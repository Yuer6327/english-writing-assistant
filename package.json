{
  "name": "english-writing-assistant",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create writing-assistant-db",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:remote": "node scripts/migrate.js --remote",
    "typecheck": "tsc --noEmit",
    "csp:check": "node scripts/csp-hash.js",
    "csp:hash": "node scripts/csp-hash.js --print",
    "inj:test": "esbuild scripts/injection-test.mjs scripts/review-guard-test.mjs --bundle --format=esm --platform=node --outdir=.wrangler/test --log-level=warning && node .wrangler/test/injection-test.js && node .wrangler/test/review-guard-test.js",
    "check": "npm run typecheck && npm run csp:check && npm run inj:test",
    "secret:key": "wrangler secret put ENCRYPTION_KEY"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
